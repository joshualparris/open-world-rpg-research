      { "id": "crucial", "pattern": "\\bcrucial\\b", "weight": 1, "note": "Stakes inflation." },
      { "id": "groundbreaking", "pattern": "\\bgroundbreaking\\b", "weight": 2, "note": "Empty praise." }
