      { "id": "in-conclusion", "pattern": "\\bin conclusion\\b", "weight": 2 },
      { "id": "to-sum", "pattern": "\\bto sum up\\b", "weight": 2 },
      { "id": "in-summary", "pattern": "\\bin summary\\b", "weight": 1 },
      { "id": "despite-challenges", "pattern": "despite (these|its|the) challenges", "weight": 2 },
      { "id": "here-kicker", "pattern": "here'?s (the kicker|the thing|where it gets interesting|what most people miss)", "weight": 3 },
      { "id": "imagine-world", "pattern": "imagine a world where", "weight": 2 },
      { "id": "think-of-it", "pattern": "think of it (as|like)", "weight": 1 },
      { "id": "truth-is", "pattern": "the (truth|reality) is (simple|clear|unambiguous)", "weight": 2 },
      { "id": "real-story", "pattern": "the real story is", "weight": 2 }
    ],
    "structure": [
      { "id": "not-x-it-y", "pattern": "\\bnot\\s+[^.!?]{1,60}[.!?]\\s*(it'?s|it is|they'?re|they are)\\s+", "weight": 3, "note": "Negative parallelism." },
      { "id": "not-because-but", "pattern": "not because\\s+[^.!?]{1,80}\\bbut because\\b", "weight": 2 },
      { "id": "question-is", "pattern": "the question isn'?t\\s+[^.!?]{1,80}[.!?]\\s*the question is", "weight": 3 },
      { "id": "not-x-not-y", "pattern": "\\bnot\\s+[^.!?]{1,40}[.!?]\\s*not\\s+[^.!?]{1,40}[.!?]\\s*(just|but|only)?\\s*", "weight": 2, "note": "Dramatic countdown." },
      { "id": "x-a-y", "pattern": "\\bthe\\s+[a-z]+\\?\\s+a\\s+[a-z]+", "weight": 2, "note": "Self-posed rhetorical question." },
      { "id": "anaphora", "pattern": "\\b(they|we|it|you)\\s+[^.!?]{1,50}[.!?]\\s*\\1\\s+", "weight": 2, "note": "Repeated sentence opening; approximate." },
      { "id": "tricolon", "pattern": "\\b\\w+,\\s+\\w+,\\s+and\\s+\\w+\\b", "weight": 1, "note": "One is fine; clusters are a tell." },
      { "id": "short-fragment", "pattern": "(^|[.!?]\\s+)[A-Z][a-z]{1,12}[.!?]\\s+[A-Z][a-z]{1,12}[.!?]", "weight": 1, "note": "Punchy fragments; approximate." },
      { "id": "bold-bullet", "pattern": "^\\s*[-*]\\s+\\*\\*[^*]+\\*\\*", "weight": 2, "note": "Bold-first bullets; common in AI docs." },
      { "id": "em-dash", "pattern": "—", "weight": 1, "note": "Count per 1000 words; 20+ is a tell." }
    ],
