{
  "meta": {
    "name": "AI slop pattern watchlist",
    "note": "Frequency matters. One use of any pattern can be fine. This is a triage list, not a banlist. Tune per project and genre; track displacement after changes.",
    "version": "1"
  },
  "categories": {
    "lexical": [
      { "id": "delve", "pattern": "\\bdelve(s|d|ing)?\\b", "weight": 3, "note": "The classic AI tell; legitimate in small doses." },
      { "id": "tapestry", "pattern": "\\btapestry\\b", "weight": 3, "note": "Grandiose noun for 'mix' or 'whole'." },
      { "id": "testament", "pattern": "\\btestament\\b", "weight": 2, "note": "Usually 'a testament to'." },
      { "id": "realm", "pattern": "\\brealm\\b", "weight": 2, "note": "Fantasy default; often vague." },
      { "id": "landscape", "pattern": "\\blandscape\\b", "weight": 1, "note": "Overused for any field; legitimate for physical landscape." },
      { "id": "navigate", "pattern": "\\bnavigat(e|es|ed|ing)\\b", "weight": 2, "note": "Metaphorical navigation is a corporate-AI tell." },
      { "id": "leverage", "pattern": "\\bleverag(e|es|ed|ing)\\b", "weight": 2, "note": "Verb use is usually jargon." },
      { "id": "robust", "pattern": "\\brobust\\b", "weight": 1, "note": "Often empty." },
      { "id": "seamless", "pattern": "\\bseamless(ly)?\\b", "weight": 2, "note": "Empty praise." },
      { "id": "meticulous", "pattern": "\\bmeticulous(ly)?\\b", "weight": 2, "note": "Often tells instead of shows." },
      { "id": "intricate", "pattern": "\\bintricate\\b", "weight": 2, "note": "Often vague." },
      { "id": "pivotal", "pattern": "\\bpivotal\\b", "weight": 2, "note": "Stakes inflation." },
      { "id": "vibrant", "pattern": "\\bvibrant\\b", "weight": 2, "note": "Generic city/colour praise." },
      { "id": "bustling", "pattern": "\\bbustling\\b", "weight": 2, "note": "Generic market/street." },
      { "id": "nestled", "pattern": "\\bnestled\\b", "weight": 2, "note": "Generic village/valley." },
      { "id": "breathtaking", "pattern": "\\bbreathtaking\\b", "weight": 2, "note": "Tells the reader what to feel." },
      { "id": "unwavering", "pattern": "\\bunwavering\\b", "weight": 2, "note": "Generic resolve." },
      { "id": "palpable", "pattern": "\\bpalpable\\b", "weight": 3, "note": "Classic 'the tension was palpable'." },
      { "id": "cacophony", "pattern": "\\bcacophony\\b", "weight": 2, "note": "Generic sensory shortcut." },
      { "id": "symphony", "pattern": "\\bsymphony\\b", "weight": 2, "note": "Metaphor abuse." },
      { "id": "shimmer", "pattern": "\\bshimmer(s|ed|ing)?\\b", "weight": 2, "note": "Atmospheric default." },
      { "id": "whisper", "pattern": "\\bwhisper(s|ed|ing)?\\b", "weight": 1, "note": "Atmospheric default; legitimate for actual whispering." },
      { "id": "journey", "pattern": "\\bjourney\\b", "weight": 1, "note": "Abstract 'journey' is usually filler." },
      { "id": "unlock", "pattern": "\\bunlock(s|ed|ing)?\\b", "weight": 2, "note": "Marketing/AI metaphor." },
      { "id": "elevate", "pattern": "\\belevat(e|es|ed|ing)\\b", "weight": 2, "note": "Marketing verb." },
      { "id": "embark", "pattern": "\\bembark(s|ed|ing)?\\b", "weight": 2, "note": "Quest cliché." },
      { "id": "myriad", "pattern": "\\bmyriad\\b", "weight": 2, "note": "Inflated quantity." },
